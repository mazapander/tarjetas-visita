# Copia este fichero a .env y rellena lo que necesites. Nunca subas .env al repo.

# OCR con Mistral (opcional). Sin clave solo se procesan ficheros .txt.
MISTRAL_API_KEY=

# Fallback LLM para completar la extracción: disabled | mistral | openai_compatible
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Rutas (relativas a la raíz del repo). Los valores por defecto suelen bastar.
# PROJECT_FILES_DIR=project_files
# SQLITE_DB_PATH=project_files/app/tarjetasvisita.db
# RAW_CARDS_DIR=project_files/raw/cards
# OCR_OUTPUT_DIR=project_files/processed/ocr
# ENTITIES_OUTPUT_DIR=project_files/processed/entities
# EXPORTS_DIR=project_files/exports
# REPORTS_DIR=project_files/reports
